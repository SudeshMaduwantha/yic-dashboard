rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // One profile photo per student, overwritten on re-upload. Write access requires
    // a verified /student_sessions doc for this exact studentCode (Firestore is the
    // source of truth for "who is this session" — see firestore.rules). Size/type are
    // enforced here since there is no backend to double-check uploads.
    match /student_photos/{code}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/student_sessions/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/student_sessions/$(request.auth.uid)).data.studentCode == code
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
