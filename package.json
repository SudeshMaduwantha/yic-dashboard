{
  "name": "yic-dashboard",
  "version": "1.0.3",
  "description": "YIC Sport School attendance & fees dashboard",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "release": "node scripts/release.js"
  },
  "author": {
    "name": "Sudesh Kumarasiri"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SudeshMaduwantha/yic-dashboard.git"
  },
  "build": {
    "appId": "com.yic.sportschool.dashboard",
    "productName": "YIC Sport School",
    "copyright": "Copyright © 2026 Yorkshire International College",
    "npmRebuild": false,
    "directories": {
      "output": "C:\\Users\\sudes\\yic-dashboard-builds"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "nsis": {
      "license": "LICENSE.txt",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "SudeshMaduwantha",
      "repo": "yic-dashboard"
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0"
  }
}
