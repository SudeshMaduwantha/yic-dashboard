rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // A coach can be assigned to more than one sport (stored as a "sports" array).
    // Falls back to the older single-value "sport" field so accounts created before
    // this existed keep working without a data migration.
    function mySports() {
      let data = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.sports != null ? data.sports : (data.sport != null ? [data.sport] : []);
    }
    function isSuperAdmin() { return isSignedIn() && myRole() == 'super_admin'; }
    function isAdministrator() { return isSignedIn() && myRole() == 'administrator'; }
    function isCoach() { return isSignedIn() && myRole() == 'coach'; }

    // Student self-service portal: a verified session proves the caller supplied a
    // valid Student ID + PIN pair for `code` at some point (see /student_sessions
    // below). Anonymous Auth only, never mixed with the staff `users` collection.
    function isVerifiedStudent(code) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/student_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/student_sessions/$(request.auth.uid)).data.studentCode == code;
    }

    function superAdminClaimed() {
      return exists(/databases/$(database)/documents/meta/access)
        && get(/databases/$(database)/documents/meta/access).data.superAdminClaimed == true;
    }

    // One-time bootstrap flag: flips true the moment the first Super Admin claims their role.
    match /meta/access {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !superAdminClaimed() && request.resource.data.superAdminClaimed == true;
    }

    // Staff accounts and their role/sport assignment.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Super Admin creates any account. The very first account may self-claim super_admin
      // once, before anyone has claimed it (see meta/access above).
      allow create: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == 'super_admin'
            && !superAdminClaimed());
      allow update, delete: if isSuperAdmin();
    }

    // Student roster + attendance. Coaches are scoped to their assigned sport(s) — the
    // app always issues a where('sport','in', mySports()) query for coach logins so
    // this rule can be verified against the query itself, not just individual docs.
    // Administrators can update (e.g. set a Student ID) but not create/delete students.
    match /students/{id} {
      allow read: if isSuperAdmin() || isAdministrator()
        || (isCoach() && resource.data.sport in mySports());
      allow create: if isSuperAdmin() || (isCoach() && request.resource.data.sport in mySports());
      allow update: if isSuperAdmin() || isAdministrator()
        || (isCoach() && resource.data.sport in mySports() && request.resource.data.sport in mySports());
      allow delete: if isSuperAdmin() || isAdministrator();
    }

    // Fee ledger. Administrators can fully manage it. Coaches can only read records for
    // their own sport(s) (the app displays paid/unpaid status to them, never the amount).
    match /fees/{id} {
      allow read: if isSuperAdmin() || isAdministrator()
        || (isCoach() && resource.data.sport in mySports());
      allow write: if isSuperAdmin() || isAdministrator();
    }

    // Coach directory, one doc per sport. Any signed-in staff can see who runs a
    // sport; only Super Admin assigns/edits it.
    match /sport_coaches/{sport} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Standard monthly fee per sport, used to auto-fill the Add Record form.
    // Administrators need to read it (they add fees) but only Super Admin sets it.
    match /sport_fees/{sport} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Per-person metadata (Student ID -> PIN) used for the public parent lookup.
    match /student_meta/{code} {
      allow read, write: if isSuperAdmin() || isAdministrator();
    }

    // Denormalized public snapshot, keyed by "<studentCode>::<pin>". Knowing the
    // exact ID *is* the credential — get (exact match) is public, list (browsing/
    // enumeration) is always blocked, so records can't be discovered without both
    // pieces of info.
    match /public_lookup/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isSuperAdmin() || isAdministrator();
    }

    // Student portal session, keyed by the (Anonymous Auth) uid that created it.
    // Created only after the client proves it knows a valid Student ID + PIN pair —
    // the `create` rule independently re-checks that against /public_lookup itself,
    // so a forged session doc is rejected server-side regardless of client claims.
    // Sessions are create-once / delete-on-logout; never mutated in place.
    match /student_sessions/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.studentCode is string
        && request.resource.data.pin is string
        && exists(/databases/$(database)/documents/public_lookup/$(request.resource.data.studentCode + '::' + request.resource.data.pin));
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // Self-service editable profile fields, separate from /students/{id} on purpose:
    // one person can have multiple /students docs (one per sport, sharing the same
    // studentCode), and this keeps the student-writable surface narrow instead of
    // fanning out edits across N docs or touching attendance/fee-adjacent data.
    //
    // photoUrl holds a small base64 data: URI, not a Storage download URL — this
    // project is on the Spark (free) plan and Storage requires Blaze, so the profile
    // photo is stored directly in Firestore instead. The size check keeps it well
    // under Firestore's 1MiB document limit (client resizes to a small JPEG first;
    // this is the actual server-side enforcement, not just client-side trust).
    // Each field is optional-but-type-checked, not required — a student can upload a
    // photo before ever saving their phone/emergency contact (or vice versa); the two
    // forms on the portal page save independently via separate merge writes.
    match /student_profiles/{code} {
      allow read: if isSuperAdmin() || isAdministrator() || isCoach() || isVerifiedStudent(code);
      allow create, update: if isVerifiedStudent(code)
        && request.resource.data.keys().hasOnly(['phone', 'emergencyContact', 'photoUrl', 'photoUpdatedAt', 'updatedAt'])
        && (!('phone' in request.resource.data) || request.resource.data.phone is string)
        && (!('emergencyContact' in request.resource.data) || request.resource.data.emergencyContact is string)
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl.size() < 700000);
      allow write: if isSuperAdmin() || isAdministrator();
      allow delete: if isSuperAdmin();
    }
  }
}
